# Copy to .env.local for development, or provide these at build time in CI.
#
# Development: leave the two URLs empty and the dev server proxies /api and /ws
# to VITE_DEV_API_TARGET, so the browser stays same-origin and no CORS config
# is needed on the backend.
VITE_DEV_API_TARGET=http://localhost:8080

# Deployed builds: leave empty when the SPA is served from the same origin as
# the API (recommended — see nginx.conf). Otherwise point them at the gateway.
VITE_API_BASE_URL=
VITE_SOCKJS_URL=

# Abort HTTP requests that have not responded within this many milliseconds.
VITE_REQUEST_TIMEOUT_MS=15000
